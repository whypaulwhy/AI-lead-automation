{
  "name": "Lead Responder: error alerts",
  "nodes": [
    {
      "parameters": {
        "content": "## Error alerts\nRuns when the lead workflow fails in production and posts the failed step, the error and a link to the run in Slack. If Slack is down too, it emails the office instead.",
        "height": 560,
        "width": 1000,
        "color": 7
      },
      "id": "8311fa32-1c68-4400-a426-3d41a4843d18",
      "name": "Note: what this does",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -60,
        60
      ]
    },
    {
      "parameters": {},
      "id": "c41138c5-af8b-48c3-a2e0-426b81964379",
      "name": "When the lead workflow fails",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [
        0,
        300
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "%%CODE:format-error-alert%%"
      },
      "id": "da7b2337-457f-41fe-a98f-bc0362732a5c",
      "name": "Format error alert",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "%%SLACK_WEBHOOK_URL%%",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ text: $json.slack_text }) }}",
        "options": {
          "timeout": 10000
        }
      },
      "id": "3fd07197-0f11-4b8d-aae2-993cd0df33da",
      "name": "Post error to Slack",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        480,
        300
      ],
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 2000,
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "fromEmail": "%%FROM_HEADER%%",
        "toEmail": "%%OFFICE_EMAIL%%",
        "subject": "={{ $('Format error alert').first().json.office_subject }}",
        "emailFormat": "text",
        "text": "={{ $('Format error alert').first().json.office_text }}",
        "options": {
          "appendAttribution": false
        }
      },
      "id": "f1598bc4-2dc2-433f-a7b3-b7fc9fa686ae",
      "name": "Email the office instead",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        720,
        420
      ],
      "credentials": {
        "smtp": {
          "id": "%%N8N_CRED_SMTP_ID%%",
          "name": "Gmail SMTP (demo sender)"
        }
      },
      "onError": "continueRegularOutput"
    }
  ],
  "connections": {
    "When the lead workflow fails": {
      "main": [
        [
          {
            "node": "Format error alert",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Format error alert": {
      "main": [
        [
          {
            "node": "Post error to Slack",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Post error to Slack": {
      "main": [
        [],
        [
          {
            "node": "Email the office instead",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "America/Chicago",
    "saveDataSuccessExecution": "all",
    "saveDataErrorExecution": "all",
    "saveManualExecutions": true
  }
}
