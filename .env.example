# Copy this file to .env and fill it in. .env is gitignored and must never be committed.
# Comments sit on their own lines on purpose: some .env parsers read a trailing "# ..." as part of the value.

# ---------- n8n ----------
# Exact n8n 2.x image tag, pinned in Phase 1
N8N_VERSION=
# Generated once in Phase 1. Never change it after credentials exist.
N8N_ENCRYPTION_KEY=
N8N_BASE_URL=http://localhost:5678
# n8n > Settings > n8n API > Create an API key
N8N_API_KEY=

# ---------- AI ----------
# bridge = Claude Code on your Claude plan through scripts/ai-bridge.mjs (demo, no API bill)
# api    = Anthropic Messages API with the client's own key, stored in an n8n credential
AI_MODE=bridge
# 127.0.0.1 keeps the bridge off your network; Docker Desktop still forwards host.docker.internal to it.
AI_BRIDGE_HOST=127.0.0.1
AI_BRIDGE_PORT=8787
# Shared secret between n8n and the bridge. Generated in Phase 1.
AI_BRIDGE_TOKEN=
# Optional. Long-lived Claude Code login from `claude setup-token`. Empty = use your normal Claude Code login.
CLAUDE_CODE_OAUTH_TOKEN=
# Never add ANTHROPIC_API_KEY to this file in bridge mode: Claude Code would bill the API instead of your plan.

# ---------- n8n credential IDs (open the credential in n8n; the ID is the last part of the URL) ----------
# Header Auth credential "AI bridge token" (bridge mode)
N8N_CRED_AI_BRIDGE_ID=
# Header Auth credential "Anthropic API key" (api mode only)
N8N_CRED_ANTHROPIC_ID=
N8N_CRED_SMTP_ID=
N8N_CRED_GOOGLE_SHEETS_ID=

# ---------- Integrations ----------
# https://hooks.slack.com/services/...
SLACK_WEBHOOK_URL=
# The part of the sheet URL between /d/ and /edit
GOOGLE_SHEET_ID=
GOOGLE_SHEET_TAB=Leads
# Cal.com or Calendly event link
BOOKING_URL=
# Demo sender Gmail (SMTP user)
SENDER_EMAIL=
# Demo inbox that receives all test replies
TEST_INBOX=

# ---------- Site ----------
SITE_ORIGIN=http://localhost:8080
